{
  "name": "imodel-explorer",
  "version": "0.2.1",
  "repository": { "type": "git", "url": "https://github.com/khanaffan/imodel-explorer.git" },
  "private": true,
  "license": "MIT",
  "description": "iModel Data Explorer: a developer tool that opens an iModel and renders an interactive EC instance graph.",
  "main": "dist/backend/main.js",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "lint": "eslint src test scripts",
    "start": "npm run build && electron .",
    "dev": "npm run build:backend && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:3000 && cross-env IG_DEV=1 electron .\"",
    "sample": "vite-node scripts/makeSample.ts",
    "sample:demo": "vite-node scripts/makeDemo.ts",
    "smoke": "node scripts/smoke.mjs",
    "bench": "vite-node scripts/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:shots": "node scripts/tutorialShots.mjs",
    "docs:tts-setup": "bash scripts/setupKokoro.sh",
    "docs:video": "node scripts/tutorialVideo.mjs"
  },
  "dependencies": {
    "@bentley/icons-generic-webfont": "^1.0.34",
    "@itwin/appui-abstract": "5.14.0",
    "@itwin/appui-react": "5.35.1",
    "@itwin/components-react": "5.35.1",
    "@itwin/core-backend": "5.14.0",
    "@itwin/core-bentley": "5.14.0",
    "@itwin/core-common": "5.14.0",
    "@itwin/core-electron": "5.14.0",
    "@itwin/core-frontend": "5.14.0",
    "@itwin/core-geometry": "5.14.0",
    "@itwin/core-i18n": "5.14.0",
    "@itwin/core-orbitgt": "5.14.0",
    "@itwin/core-quantity": "5.14.0",
    "@itwin/core-react": "5.35.1",
    "@itwin/ecschema-metadata": "5.14.0",
    "@itwin/ecschema-rpcinterface-common": "5.14.0",
    "@itwin/ecschema-rpcinterface-impl": "5.14.0",
    "@itwin/imodel-components-react": "5.35.1",
    "@itwin/itwinui-icons-react": "2.11.0",
    "@itwin/itwinui-react": "3.22.0",
    "@itwin/presentation-backend": "5.14.0",
    "@itwin/presentation-common": "5.14.0",
    "@itwin/presentation-components": "^5.16.4",
    "@itwin/presentation-frontend": "5.14.0",
    "@itwin/tree-widget-react": "^4.0.0-alpha.33",
    "@itwin/unified-selection": "^2.0.0-alpha.0",
    "@itwin/webgl-compatibility": "5.14.0",
    "@mui/material": "^9.4.0",
    "@stratakit/bricks": "^0.5.6",
    "@stratakit/foundations": "^0.5.0",
    "@stratakit/icons": "^0.4.4",
    "@stratakit/mui": "^0.5.4",
    "@stratakit/structures": "^0.5.10",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "html-to-image": "^1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "44.4.5",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "26.1.0",
    "playwright-core": "^1.55.0",
    "sass-embedded": "^1.105.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.1.5",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  }
}
